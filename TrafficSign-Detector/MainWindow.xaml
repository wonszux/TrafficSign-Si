<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrafficSign.Detector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrafficSign — klasyfikacja znaku">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="TrafficSign">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" Padding="32" MaxWidth="960" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="Rozpoznawanie znaków" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Wybierz model i zdjęcie jednego, wykadrowanego znaku." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <Button x:Name="ChooseModelButton" Content="1. Wybierz model JSON" Click="ChooseModel_Click"
                            AutomationProperties.Name="Wybierz model JSON" />
                    <TextBlock x:Name="ModelDescription" Text="Model nie został wybrany." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ChooseImageButton" Content="2. Wybierz zdjęcie" Click="ChooseImage_Click"
                            AutomationProperties.Name="Wybierz zdjęcie znaku w formacie JPEG lub PNG" />
                    <TextBlock x:Name="ImageDescription" Text="Obsługiwane obrazy: JPEG i PNG." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                    <Grid Height="260">
                        <TextBlock x:Name="PreviewPlaceholder" Text="Podgląd wybranego zdjęcia" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Podgląd wybranego znaku" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PredictButton" Content="3. Rozpoznaj znak" Click="Predict_Click" IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Rozpoznaj znak" />
                    <ProgressRing x:Name="BusyIndicator" Width="24" Height="24" IsActive="False" Visibility="Collapsed"
                                  AutomationProperties.Name="Trwa przetwarzanie" />
                </StackPanel>
                <InfoBar x:Name="ErrorMessage" IsOpen="False" Severity="Error" Title="Nie udało się wykonać operacji"
                         IsClosable="True" />
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ResultLabel" Text="Wynik pojawi się tutaj." Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ResultScore" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="Model wybiera jedną ze znanych klas. Wynik softmax nie gwarantuje poprawności. Program nie wyszukuje znaków na zdjęciu ulicy i nie rozpoznaje klasy „brak znaku”."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
